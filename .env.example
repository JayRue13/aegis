# Copy to .env.local for local development, or add these in your host's
# environment settings (Vercel: Project → Settings → Environment Variables).
# Every value is optional: with none set, AEGIS runs in offline demo mode.

# ---------- Model providers (add at least one; all have free tiers) ----------
# OpenRouter: https://openrouter.ai/keys  (only free models are listed unless OPENROUTER_ALLOW_PAID=true)
OPENROUTER_API_KEY=
# OPENROUTER_ALLOW_PAID=false
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile

# Your own Ollama server (must be reachable from the AEGIS server, e.g. via Tailscale or a tunnel)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODELS=qwen3:4b

# Any other OpenAI-compatible endpoint
# CUSTOM_OPENAI_BASE_URL=
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_MODELS=
# CUSTOM_OPENAI_LABEL=Custom

# Default model id shown first, e.g. gemini:gemini-2.5-flash
# AEGIS_DEFAULT_MODEL=

# ---------- Accounts and sync (Supabase, free tier) ----------
# From Supabase → Project Settings → API. The anon key is safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional OAuth buttons (enable the providers in Supabase → Authentication first): github,google
# NEXT_PUBLIC_AUTH_PROVIDERS=
# Comma-separated invite list. Leave empty to allow any signed-in user.
# AEGIS_ALLOWED_EMAILS=you@example.com

# ---------- Protection without Supabase ----------
# A shared passphrase required to chat. Production deployments with model keys
# refuse all requests unless this or Supabase is configured.
# AEGIS_ACCESS_CODE=

# ---------- Misc ----------
# AEGIS_RATE_LIMIT_PER_MIN=20
# AEGIS_PUBLIC_URL=https://your-aegis.vercel.app
# AEGIS_LINK_READER=true   # set to false to stop AEGIS reading links in messages
# AEGIS_DEMO_MODE=        # "true" forces the demo model on, "false" forces it off
